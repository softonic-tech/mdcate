# Backend API URL (browser + server-side /auth/me check)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Optional if different from the public URL
# API_URL=http://localhost:5000/api/v1

# S3 for admin direct uploads (presign route).
# On Netlify, AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are reserved — use S3_* below.
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=your_bucket_name

# Local/other hosts may use standard names instead (optional fallbacks in code):
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET=



