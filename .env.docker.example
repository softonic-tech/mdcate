# =============================================================================
# Copy to project root as `.env` before: docker compose up -d --build
# cp .env.docker.example .env
# =============================================================================

# --- EC2 public IP ---
PUBLIC_HOST=54.163.157.90

# --- Public URLs (ports match security group: 3000 / 4000 / 5000) ---
FRONTEND_URL=http://54.163.157.90:3000
ADMINPANEL_URL=http://54.163.157.90:4000
BACKEND_URL=http://54.163.157.90:5000
CORS_ORIGINS=http://54.163.157.90:3000,http://54.163.157.90:4000,http://54.163.157.90:5000

# Baked into frontend/admin images at build time — rebuild after changing
NEXT_PUBLIC_API_URL=http://54.163.157.90:5000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# --- RabbitMQ (internal Docker network) ---
RABBITMQ_USER=medprep
RABBITMQ_PASSWORD=change_this_strong_password

# --- Auth (required) ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# --- Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_NAME=medprep.study
ADMIN_EMAIL=admin@medprep.study

# --- AWS S3 (all file storage: profiles, books, notes, voice, videos) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=

# --- Google OAuth ---
# Redirect URI (add in Google Console):
#   http://54.163.157.90:5000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth ---
# Redirect URI (add in Facebook App):
#   http://54.163.157.90:5000/api/v1/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- OpenAI (video summarizer + MCQ import) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# --- Billing ---
TRIAL_DAYS=7
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SUB_MERCHANT_ID=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# =============================================================================
# OAuth / S3: allow these origins in provider consoles:
#   Frontend  http://54.163.157.90:3000
#   Admin     http://54.163.157.90:4000
#   API       http://54.163.157.90:5000
#
# Rebuild after changing NEXT_PUBLIC_* or URLs:
#   docker compose build frontend admin --no-cache && docker compose up -d
# =============================================================================
