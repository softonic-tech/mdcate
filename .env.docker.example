# =============================================================================
# Copy to project root as `.env` before: docker compose up -d --build
# cp .env.docker.example .env
# =============================================================================

# --- Domain (production) ---
DOMAIN=medprep.study
PUBLIC_HOST=medprep.study

# --- Public URLs (HTTPS via nginx — rebuild frontend/admin after changing) ---
FRONTEND_URL=https://medprep.study
ADMINPANEL_URL=https://admin.medprep.study
BACKEND_URL=https://api.medprep.study
CORS_ORIGINS=https://medprep.study,https://admin.medprep.study,https://api.medprep.study

NEXT_PUBLIC_API_URL=https://api.medprep.study/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# --- MongoDB Atlas (required — not stored on EC2) ---
# Atlas → Network Access: allow your EC2 public IP (54.163.157.90)
# Atlas → Database Access: user with read/write on your database
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mdcate?retryWrites=true&w=majority

# Atlas pool/timeout tuning (all optional — sensible defaults are baked in).
# Size MAX_POOL_SIZE so (instances × MAX_POOL_SIZE) stays well under the tier
# connection cap (M0=500, M2=500, M5=1000, M10=1500). On a single EC2 box with
# one backend container, 50 is plenty; raise it if you scale horizontally.
# MONGODB_MAX_POOL_SIZE=50
# MONGODB_MIN_POOL_SIZE=2
# MONGODB_SERVER_SELECTION_MS=8000
# MONGODB_SOCKET_TIMEOUT_MS=45000
# MONGODB_CONNECT_TIMEOUT_MS=15000
# MONGODB_MAX_RETRY_ATTEMPTS=8

# --- RabbitMQ (internal Docker network) ---
RABBITMQ_USER=medprep
RABBITMQ_PASSWORD=change_this_strong_password

# --- Auth (required) ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# --- Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_NAME=medprep.study
ADMIN_EMAIL=admin@medprep.study

# --- AWS S3 (all file storage: profiles, books, notes, voice, videos) ---
# Consumed by BOTH backend (direct uploads + deletes) AND admin (presigned PUT URLs
# for books PDFs/covers and chapter videos via /api/upload/s3-presign).
# The S3 bucket must have a CORS policy allowing PUT from the admin origin, e.g.:
#   AllowedOrigins: ["https://admin.medprep.study"]
#   AllowedMethods: ["PUT","GET","HEAD"]
#   AllowedHeaders: ["*"]
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=

# --- Google OAuth ---
# Authorized redirect URI (Google Cloud Console):
#   https://api.medprep.study/api/v1/auth/google/callback
# Authorized JavaScript origins:
#   https://medprep.study
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth ---
# Valid OAuth redirect URI (Facebook App):
#   https://api.medprep.study/api/v1/auth/facebook/callback
# App domains: medprep.study
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- OpenAI (video summarizer + MCQ import) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# --- Video summarizer (yt-dlp / YouTube) ---
# Production servers are often blocked by YouTube without browser cookies.
# 1. Log into YouTube in Chrome/Firefox on your machine
# 2. Export cookies.txt (Netscape format) — see yt-dlp wiki "Exporting YouTube cookies"
# 3. On the server:
#      mkdir -p secrets
#      # upload the file to secrets/youtube-cookies.txt (must be a FILE, not a folder)
# 4. Set YTDLP_COOKIES_FILE below and ensure docker-compose mounts ./secrets:/app/secrets:ro
YTDLP_COOKIES_FILE=/app/secrets/youtube-cookies.txt
# Optional override (default in code: youtube:player_client=tv,ios,web_safari)
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=tv,ios,web_safari

# Behind nginx (fixes express-rate-limit X-Forwarded-For warning)
TRUST_PROXY=1

# --- Billing ---
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SUB_MERCHANT_ID=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# =============================================================================
# MongoDB Atlas:
#   1. Network Access → Add IP Address → EC2 public IP (or Elastic IP)
#   2. Database → Connect → Drivers → copy connection string into MONGODB_URI
#
# DNS checklist (at your registrar):
#   A     @      → EC2 public IP (e.g. 54.163.157.90)
#   A     www    → same IP (or CNAME www → medprep.study)
#   CNAME api    → medprep.study
#   CNAME admin  → medprep.study
#
# AWS security group: open TCP 80 and 443
#
# After DNS propagates:
#   docker compose up -d --build
#   ./deploy/setup-ssl.sh admin@medprep.study
#
# Rebuild after changing NEXT_PUBLIC_* or URLs:
#   docker compose build frontend admin --no-cache && docker compose up -d
# =============================================================================
