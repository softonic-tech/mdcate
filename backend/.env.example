# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://medprep.study
# Optional: comma-separated origins for REST + Socket.IO (overrides dev defaults)
# CORS_ORIGINS=http://localhost:3003,http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/medprep-study

# MongoDB / Atlas connection tuning (all optional — defaults shown).
# Size MAX_POOL_SIZE so `numBackendInstances * MAX_POOL_SIZE` stays well below
# the Atlas tier connection cap (M0=500, M2=500, M5=1000, M10=1500).
# MONGODB_MAX_POOL_SIZE=50
# MONGODB_MIN_POOL_SIZE=2
# MONGODB_SERVER_SELECTION_MS=8000   # how long a request waits for a healthy primary
# MONGODB_SOCKET_TIMEOUT_MS=45000    # kill stuck queries; prevents pool exhaustion
# MONGODB_CONNECT_TIMEOUT_MS=15000   # per-attempt TCP handshake timeout
# MONGODB_MAX_RETRY_ATTEMPTS=8       # initial-connect retries with exp backoff (~2 min total)

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRE=30d

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
FROM_NAME=medprep.study

# AWS S3 (profile pictures, books, notes, voice messages, chapter videos)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_BUCKET=your_bucket_name
# S3 bucket CORS (browser uploads admin → S3): allow PUT from your admin origin, e.g.
# [{"AllowedHeaders":["*"],"AllowedMethods":["PUT","GET","HEAD"],"AllowedOrigins":["https://your-admin.vercel.app","http://localhost:3001"]}]

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/v1/auth/facebook/callback

# RabbitMQ (optional at runtime — if connection fails, API still starts; workers stay off)
# Local: docker run -d --name rabbit -p 5672:5672 rabbitmq:3-management
RABBITMQ_URL=amqp://localhost:5672
# Default broker login (many local/docker setups): amqp://guest:guest@localhost:5672
# Production: hosted AMQP URL, e.g. amqp://user:pass@your-instance.cloudamqp.com/vhost

# Notes file uploads: on AWS Lambda / Vercel, disk uploads are skipped automatically (memory + S3).
# Force memory uploads locally: NOTES_USE_MEMORY_UPLOAD=true
# Custom writable directory (VPS): NOTES_UPLOAD_DIR=/var/app/uploads/notes

# OpenAI (video summarizer)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# Admin
ADMIN_EMAIL=admin@medprep.study

# Billing & subscriptions
TRIAL_DAYS=7
BACKEND_URL=http://localhost:5000

# JazzCash (sandbox: https://sandbox.jazzcash.com.pk)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SUB_MERCHANT_ID=
# JAZZCASH_CHECKOUT_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/

# Easypaisa (sandbox: https://easypaystg.easypaisa.com.pk)
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
# EASYPAISA_CHECKOUT_URL=https://easypaystg.easypaisa.com.pk/easypay/Index.jsf
